# Backend Configuration
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Database (PostgreSQL / SQLite fallback)
DATABASE_URL=postgresql://user:password@localhost:5432/society_tracker
DATABASE_SSL=false

# Authentication
JWT_SECRET=your_secure_random_jwt_secret_here

# Default Seed Accounts (For development/demo)
SEED_ADMIN_EMAIL=admin@society.com
SEED_ADMIN_PASSWORD=Admin@123

# SMTP Email Configuration (Optional - logs to console if omitted)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM=noreply@society.com

# Frontend Configuration (for frontend/.env)
VITE_API_URL=http://localhost:4000/api
