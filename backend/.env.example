# Server
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Database (PostgreSQL). On Render, use the "External Database URL" it gives you.
DATABASE_URL=postgresql://user:password@localhost:5432/society_tracker
DATABASE_SSL=false

# Auth
JWT_SECRET=replace_with_a_long_random_secret

# Default admin account created by `npm run seed`
SEED_ADMIN_EMAIL=admin@society.com
SEED_ADMIN_PASSWORD=Admin@123

# SMTP (any free tier works: Gmail with an App Password, Brevo, Mailtrap, etc.)
# If left blank, emails are logged to the console instead of sent (safe for local dev/demo).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=your-email@gmail.com
