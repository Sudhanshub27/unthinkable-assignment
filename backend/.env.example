# Server
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Database (PostgreSQL). On Render, use the "External Database URL" it gives you.
DATABASE_URL=postgresql://user:password@localhost:5432/society_tracker
DATABASE_SSL=false

# Auth
JWT_SECRET=replace_with_a_long_random_secret

# Default admin account created by `npm run seed`
SEED_ADMIN_EMAIL=admin@society.com
SEED_ADMIN_PASSWORD=Admin@123

# Email Configuration (Option 1: Resend API Key - Recommended for Render)
RESEND_API_KEY=re_123456789_your_key_here
RESEND_FROM=Unthinkable Sudhanshu <onboarding@resend.dev>

# Email Configuration (Option 2: SMTP Provider)
# If left blank and RESEND_API_KEY is not set, emails log safely to console.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=your-email@gmail.com
