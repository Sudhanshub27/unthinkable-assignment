**/*.db-journal
**/*.db-wal
**/*.db-shm

# Uploads directory contents (preserve .gitkeep)
uploads/*
!uploads/.gitkeep
**/uploads/*
!**/uploads/.gitkeep

# System & Editor files
.DS_Store
Thumbs.db
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.vscode/
.idea/

# Zip Archives
*.zip
society-maintenance-tracker.zip
