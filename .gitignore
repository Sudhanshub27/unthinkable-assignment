# Dependencies
node_modules/
**/node_modules/

# Environment variables
.env
.env.local
.env.*.local
**/.env
!**/.env.example

# Build outputs
dist/
**/dist/
build/

# Database files
*.db
*.db-journal
*.db-wal
*.db-shm
